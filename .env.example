# Server
PORT=3001
NODE_ENV=development

# Database (Docker: replace localhost with postgres when using docker-compose)
DATABASE_URL="postgresql://CHANGE_ME@postgres:5432/laiw"

# Redis (Docker: replace localhost with redis when using docker-compose)
REDIS_URL="redis://redis:6379"

# Auth (Team Suzie shared-auth)
SESSION_SECRET="CHANGE_ME"
AUTH_COOKIE_NAME="laiw.session"

# OpenTelemetry / Team Suzie (placeholder - filled from sibling clone)
TEAMSUZIE_AGENT_BASE_URL=""
TEAMSUZIE_AGENT_API_KEY=""

# Markitdown Agent (Docker service)
MARKITDOWN_AGENT_BASE_URL="http://markitdown-agent:3013"

# Stripe (optional - set to enable billing)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
